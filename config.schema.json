{
  "pluginAlias": "Roomb-O-Matic",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Roomb-O-Matic connects to your Roomba on the local network. Close the iRobot app before capturing a password or starting Homebridge.",
  "footerDisplay": "Cloud login stays off when devices are saved here. Gigya HTTP 403 does not remove accessories Homebridge has already cached.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Roomb-O-Matic",
        "required": true
      },
      "disableDiscovery": {
        "title": "Skip iRobot cloud login",
        "type": "boolean",
        "default": true,
        "description": "Use the local devices list. Leave this on so startup does not depend on the iRobot cloud."
      },
      "enableMatter": {
        "title": "Matter robotic vacuum",
        "type": "string",
        "enum": ["auto", "on", "off"],
        "default": "auto",
        "description": "auto publishes a Matter vacuum when Homebridge Matter is available and keeps the HomeKit Fan either way. off leaves Matter unpublished."
      },
      "email": {
        "title": "iRobot account email",
        "type": "string",
        "description": "Used only when no local devices are configured and cloud login is not skipped."
      },
      "password": {
        "title": "iRobot account password",
        "type": "string",
        "description": "Used only for cloud discovery. Local devices do not send this."
      },
      "devices": {
        "title": "Robots",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "blid": {
              "title": "BLID",
              "type": "string",
              "required": true
            },
            "robotpwd": {
              "title": "Robot password",
              "type": "string",
              "required": true
            },
            "ipaddress": {
              "title": "IP address",
              "type": "string",
              "required": true,
              "format": "ipv4"
            },
            "pmapId": {
              "title": "Persistent map id",
              "type": "string",
              "description": "pmap_id from the list-rooms helper."
            },
            "userPmapvId": {
              "title": "User map version",
              "type": "string",
              "description": "user_pmapv_id from the list-rooms helper."
            },
            "cleanMode": {
              "title": "Clean mode",
              "type": "string",
              "enum": ["automatic", "deep", "quick"],
              "default": "automatic",
              "description": "Automatic lets the robot decide. Deep Clean is two passes. Quick is one pass."
            },
            "rooms": {
              "title": "Rooms",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "title": "Region id",
                    "type": "string",
                    "required": true
                  },
                  "name": {
                    "title": "Name",
                    "type": "string",
                    "required": true
                  },
                  "selected": {
                    "title": "Clean this room when the vacuum starts",
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
