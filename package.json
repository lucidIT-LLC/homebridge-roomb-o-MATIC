{
  "name": "homebridge-roomb-o-matic",
  "displayName": "Roomb-O-Matic",
  "version": "1.3.0",
  "description": "Roomba Homebridge plugin reimagined with O‑Matic Factory magic. True vacuum semantics, hybrid local + advanced support, brand-driven.",
  "author": "James Walker (O‑Matic Factory)",
  "license": "MIT",
  "homepage": "https://github.com/lucidIT-LLC/homebridge-roomb-o-MATIC#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucidIT-LLC/homebridge-roomb-o-MATIC.git"
  },
  "bugs": {
    "url": "https://github.com/lucidIT-LLC/homebridge-roomb-o-MATIC/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "iRobot",
    "Roomba",
    "Vacuum",
    "O‑Matic",
    "roomb-o-matic",
    "hybrid",
    "local",
    "supports-matter",
    "supports-hap"
  ],
  "main": "./dist/index.js",
  "type": "module",
  "engines": {
    "homebridge": "^1.9.0 || ^2.0.0",
    "node": "^20 || ^22 || ^24"
  },
  "config.schema": "./config.schema.json",
  "bin": {
    "roomb-o-matic-getpassword": "./dist/cli/get-password.js",
    "roomb-o-matic-list-rooms": "./dist/cli/list-rooms.js"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "watch": "npm run build && nodemon",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "roomba:getpassword": "node ./dist/cli/get-password.js",
    "roomba:listrooms": "node ./dist/cli/list-rooms.js"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.0.1",
    "dorita980": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.6",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.9",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
